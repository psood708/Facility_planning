# Public client settings, used by `node scripts/build.js` (set them in the
# Vercel project's Environment Variables). Both values are safe to ship to
# browsers; access is enforced by row level security in the database.
#
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# The anon / publishable key. NEVER the server-side secret key.
SUPABASE_ANON_KEY=
