{
  "name": "facility-compliance-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Pharma facility compliance checker — prototype rules engine",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:db": "node --test --test-concurrency=1 \"db-tests/*.test.js\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:e2e": "node e2e/signin.e2e.js && node e2e/projects.e2e.js && node e2e/a11y.e2e.js",
    "build": "node scripts/build.js",
    "scan": "node scripts/secret-scan.js",
    "audit:high": "npm audit --audit-level=high",
    "serve:dist": "node scripts/serve.js --dir dist --port 8000 --allow-connect http://127.0.0.1:54321"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.0",
    "axe-core": "4.14.0",
    "playwright-core": "1.65.0",
    "supabase": "3.1.0"
  }
}
